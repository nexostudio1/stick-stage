          "startMs": 140,
          "endMs": 400
        },
        {
          "text": "lo",
          "startMs": 453,
          "endMs": 560
        },
        {
          "text": "sabe?",
          "startMs": 624,
          "endMs": 1040
        }
      ]
    },
    {
      "id": "b3",
      "speaker": "mitch",
      "text": "¡Todo el mundo! Lo subí a historias.",
