          "startMs": 293,
          "endMs": 400
        },
        {
          "text": "mundo!",
          "startMs": 467,
          "endMs": 880
        },
        {
          "text": "Lo",
          "startMs": 1120,
          "endMs": 1600
        },
        {
          "text": "subí",
          "startMs": 1660,
          "endMs": 1920
        },
        {
          "text": "a",
          "startMs": 2000,
          "endMs": 2080
        },
        {
          "text": "historias.",
          "startMs": 2103,
          "endMs": 2720
        }
      ]
    },
    {
      "id": "b4",
      "speaker": "ollie",
      "text": "Error de novato.",
