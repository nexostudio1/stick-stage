          "text": "El",
          "startMs": 0,
          "endMs": 80
        },
        {
          "text": "monje",
          "startMs": 140,
          "endMs": 480
        },
        {
          "text": "no",
          "startMs": 533,
          "endMs": 640
        },
        {
          "text": "lo",
          "startMs": 667,
          "endMs": 720
        },
        {
          "text": "anuncia.",
          "startMs": 773,
          "endMs": 1760
        },
