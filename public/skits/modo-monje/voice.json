          "startMs": 1264,
          "endMs": 1760
        },
        {
          "text": "Sin",
          "startMs": 1800,
          "endMs": 1920
        },
        {
          "text": "móvil,",
          "startMs": 2000,
          "endMs": 2400
        },
        {
          "text": "sin",
          "startMs": 2440,
