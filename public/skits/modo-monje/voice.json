          "startMs": 3417,
          "endMs": 4080
        }
      ]
    },
    {
      "id": "b2",
      "speaker": "ollie",
      "text": "¿Y quién lo sabe?",
      "audio": "voice/b2.mp3",
      "durationMs": 1160,
      "words": [
