    {
      "id": "l1",
      "speaker": "milo",
      "text": "Why did nobody answer my message in the group chat?",
      "audio": "voice/l1.wav",
      "durationMs": 2905,
      "loudnessDb": -16.5,
      "peakDb": -1
    },
    {
      "id": "l2",
      "speaker": "june",
      "text": "We saw it.",
